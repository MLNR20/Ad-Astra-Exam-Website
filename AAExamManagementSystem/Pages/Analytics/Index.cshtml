@page
@model AAExamManagementSystem.Pages.Analytics.IndexModel
@{
    ViewData["Title"] = "Analytics";

    const string ApplicantHint = "Counts applicants by the date they registered.";
    const string AttemptHint = "Counts exam attempts by the date they were taken.";
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">Analytics</h1>
        <p class="text-muted mb-0 analytics-subtitle">
            @if (!Model.IsAdmin && !string.IsNullOrEmpty(Model.CurrentUserSectionName))
            {
                @:Applicant, exam and question bank overview for <strong>@Model.CurrentUserSectionName</strong>.
            }
            else if (!Model.IsAdmin)
            {
                @:Your account isn't assigned to a department yet, so no data is shown. Contact an administrator.
            }
            else
            {
                @:Applicant, exam and question bank overview.
            }
        </p>
    </div>
    <span class="text-muted small">Updated @LocalTime.Now.ToString("MMM d, yyyy h:mm tt")</span>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-tile h-100">
            <div class="card-body d-flex align-items-center gap-3 py-4">
                <span class="stat-icon bg-secondary text-white rounded-3" aria-hidden="true"><i class="bi bi-people"></i></span>
                <div>
                    <div class="fs-2 fw-bold lh-1">@Model.TotalApplicants.ToString("N0")</div>
                    <div class="text-muted">Applicants</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-tile h-100">
            <div class="card-body d-flex align-items-center gap-3 py-4">
                <span class="stat-icon bg-warning text-white rounded-3" aria-hidden="true"><i class="bi bi-pencil-square"></i></span>
                <div>
                    <div class="fs-2 fw-bold lh-1">@Model.TotalAttempts.ToString("N0")</div>
                    <div class="text-muted">Exam attempts</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-tile h-100">
            <div class="card-body d-flex align-items-center gap-3 py-4">
                <span class="stat-icon bg-success text-white rounded-3" aria-hidden="true"><i class="bi bi-graph-up"></i></span>
                <div>
                    <div class="fs-2 fw-bold lh-1">@(Model.AverageScore?.ToString("0.0") ?? "—")</div>
                    <div class="text-muted">Average score</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-tile h-100">
            <div class="card-body d-flex align-items-center gap-3 py-4">
                <span class="stat-icon bg-primary text-white rounded-3" aria-hidden="true"><i class="bi bi-question-circle"></i></span>
                <div>
                    <div class="fs-2 fw-bold lh-1">@Model.TotalQuestions.ToString("N0")</div>
                    <div class="text-muted">Question bank</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-7">
        <div class="card chart-card h-100">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                    <h2 class="chart-title mb-0">New applicants</h2>
                    <partial name="_CardFilter" model='new IndexModel.CardFilter("trend", ApplicantHint)' />
                </div>
                <div class="chart-box" data-filter-target><canvas id="applicantTrendChart" aria-label="Bar chart of new applicants per month"></canvas></div>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card chart-card h-100">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                    <h2 class="chart-title mb-0">Score distribution</h2>
                    <partial name="_CardFilter" model='new IndexModel.CardFilter("scores", AttemptHint)' />
                </div>
                <div class="chart-box" data-filter-target><canvas id="scoreDistributionChart" aria-label="Histogram of attempt scores"></canvas></div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-7">
        <div class="card chart-card h-100">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                    <h2 class="chart-title mb-0">Department preferences</h2>
                    <partial name="_CardFilter" model='new IndexModel.CardFilter("departments", ApplicantHint)' />
                </div>
                <div class="chart-box chart-box-tall" data-filter-target><canvas id="departmentChoiceChart" aria-label="Grouped bar chart of first and second department choices"></canvas></div>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card chart-card h-100">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                    <h2 class="chart-title mb-0">Applicants per year level</h2>
                    <partial name="_CardFilter" model='new IndexModel.CardFilter("yearLevels", ApplicantHint)' />
                </div>
                <div class="chart-box chart-box-tall" data-filter-target><canvas id="yearLevelChart" aria-label="Pie chart of applicants per year level"></canvas></div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-6">
        <div class="card chart-card h-100">
            <div class="card-body p-4">
                <h2 class="chart-title">Questions by section</h2>
                <div class="chart-box"><canvas id="questionSectionChart" aria-label="Bar chart of questions per section"></canvas></div>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card chart-card h-100">
            <div class="card-body p-4">
                <h2 class="chart-title">Questions by type</h2>
                <div class="chart-box"><canvas id="questionTypeChart" aria-label="Bar chart of questions per type"></canvas></div>
            </div>
        </div>
    </div>
</div>

<div class="card chart-card">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
            <h2 class="chart-title mb-0">Top scores</h2>
            <partial name="_CardFilter" model='new IndexModel.CardFilter("top", AttemptHint)' />
        </div>
        <div data-filter-target>
            <table id="topScoresTable" class="table table-striped table-hover align-middle w-100">
                <thead>
                    <tr>
                        <th class="text-start">#</th>
                        <th class="text-start">Applicant</th>
                        <th class="text-start">Student no.</th>
                        <th class="text-start">First choice</th>
                        <th class="text-start">Score</th>
                        <th class="text-start">Status</th>
                        <th class="text-start">Date</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < Model.TopAttempts.Count; i++)
                    {
                        var attempt = Model.TopAttempts[i];
                        <tr>
                            <td>@(i + 1)</td>
                            <td>@attempt.ApplicantName</td>
                            <td>@attempt.StudentNo</td>
                            <td>@(attempt.FirstChoice ?? "—")</td>
                            <td>@attempt.Score</td>
                            <td><span class="badge rounded-pill @attempt.StatusBadgeClass">@attempt.Status</span></td>
                            <td>@attempt.DateLabel</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
}

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
        $(function () {
            var SERIES_1 = '#2a78d6';
            var SERIES_2 = '#eb6834';
            var SLICE_COLORS = ['#2a78d6', '#eb6834', '#2f9e6f', '#8a63d2'];
            var SLICE_UNSPECIFIED = '#9a988f';
            var TEXT_SECONDARY = '#52514e';
            var GRID = '#e9e8e4';

            Chart.defaults.font.family = "'Manrope', sans-serif";
            Chart.defaults.color = TEXT_SECONDARY;
            Chart.defaults.plugins.tooltip.backgroundColor = '#0b0b0b';
            Chart.defaults.plugins.tooltip.padding = 10;
            Chart.defaults.plugins.tooltip.cornerRadius = 6;
            Chart.defaults.plugins.tooltip.displayColors = false;

            var topTable = initEntityTable('topScoresTable', {
                order: [],
                language: { emptyTable: 'No exam attempts recorded for this period.' },
                columnDefs: [
                    { targets: 1, className: 'text-start fw-semibold' },
                    { targets: '_all', className: 'text-start' }
                ]
            });

            function esc(value) {
                return String(value == null ? '' : value).replace(/[&<>"']/g, function (c) {
                    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
                });
            }

            function isEmpty(values) {
                return values.every(function (v) { return v === 0; });
            }

            // The canvas stays in the page; an empty state is a note shown in its place so a later filter can bring the chart back.
            function toggleEmpty(canvasId, message) {
                var box = document.getElementById(canvasId).parentElement;
                var note = box.nextElementSibling && box.nextElementSibling.classList.contains('chart-empty')
                    ? box.nextElementSibling
                    : null;
                if (message) {
                    if (!note) {
                        note = document.createElement('p');
                        note.className = 'chart-empty';
                        box.after(note);
                    }
                    note.textContent = message;
                    note.classList.remove('d-none');
                    box.classList.add('d-none');
                } else {
                    if (note) { note.classList.add('d-none'); }
                    box.classList.remove('d-none');
                }
            }

            function countAxis() {
                return {
                    beginAtZero: true,
                    ticks: { precision: 0 },
                    grid: { color: GRID },
                    border: { display: false }
                };
            }

            function categoryAxis() {
                return { grid: { display: false }, border: { color: GRID } };
            }

            function renderBar(canvasId, rows, opts) {
                var labels = rows.map(function (r) { return r.label; });
                var values = rows.map(function (r) { return r.count; });
                if (rows.length === 0 || isEmpty(values)) {
                    toggleEmpty(canvasId, opts.emptyMessage);
                    return;
                }
                toggleEmpty(canvasId, null);

                var existing = Chart.getChart(canvasId);
                if (existing) {
                    existing.data.labels = labels;
                    existing.data.datasets[0].data = values;
                    existing.update();
                    return;
                }

                new Chart(document.getElementById(canvasId), {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: opts.seriesLabel,
                            data: values,
                            backgroundColor: SERIES_1,
                            borderRadius: 4,
                            borderSkipped: 'start',
                            maxBarThickness: 32,
                            categoryPercentage: opts.histogram ? 0.96 : 0.7,
                            barPercentage: opts.histogram ? 1 : 0.9
                        }]
                    },
                    options: {
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function (ctx) { return ctx.parsed.y + ' ' + opts.unit; }
                                }
                            }
                        },
                        scales: { x: categoryAxis(), y: countAxis() }
                    }
                });
            }

            function renderChoices(choices, emptyMessage) {
                var first = choices.map(function (c) { return c.firstChoice; });
                var second = choices.map(function (c) { return c.secondChoice; });
                if (isEmpty(first.concat(second))) {
                    toggleEmpty('departmentChoiceChart', emptyMessage);
                    return;
                }
                toggleEmpty('departmentChoiceChart', null);

                var labels = choices.map(function (c) { return c.name; });
                var existing = Chart.getChart('departmentChoiceChart');
                if (existing) {
                    existing.data.labels = labels;
                    existing.data.datasets[0].data = first;
                    existing.data.datasets[1].data = second;
                    existing.update();
                    return;
                }

                new Chart(document.getElementById('departmentChoiceChart'), {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [
                            { label: 'First choice', data: first, backgroundColor: SERIES_1 },
                            { label: 'Second choice', data: second, backgroundColor: SERIES_2 }
                        ].map(function (ds) {
                            return Object.assign(ds, {
                                borderRadius: 4,
                                borderSkipped: 'start',
                                maxBarThickness: 16,
                                barPercentage: 0.9
                            });
                        })
                    },
                    options: {
                        indexAxis: 'y',
                        maintainAspectRatio: false,
                        interaction: { mode: 'index', axis: 'y', intersect: false },
                        plugins: {
                            legend: {
                                position: 'top',
                                align: 'start',
                                labels: { boxWidth: 12, boxHeight: 12, useBorderRadius: true, borderRadius: 2 }
                            },
                            tooltip: { displayColors: true }
                        },
                        scales: { x: countAxis(), y: categoryAxis() }
                    }
                });
            }

            function renderYearLevels(rows, emptyMessage) {
                // A year with no applicants would only add an empty legend entry, so leave it out of the pie.
                var present = rows.filter(function (r) { return r.count > 0; });
                if (present.length === 0) {
                    toggleEmpty('yearLevelChart', emptyMessage);
                    return;
                }
                toggleEmpty('yearLevelChart', null);

                var labels = present.map(function (r) { return r.label; });
                var values = present.map(function (r) { return r.count; });
                var colors = present.map(function (r, i) {
                    return r.label === 'Not specified' ? SLICE_UNSPECIFIED : SLICE_COLORS[i % SLICE_COLORS.length];
                });

                var existing = Chart.getChart('yearLevelChart');
                if (existing) {
                    existing.data.labels = labels;
                    existing.data.datasets[0].data = values;
                    existing.data.datasets[0].backgroundColor = colors;
                    existing.update();
                    return;
                }

                new Chart(document.getElementById('yearLevelChart'), {
                    type: 'pie',
                    data: {
                        labels: labels,
                        datasets: [{ data: values, backgroundColor: colors, borderColor: '#fff', borderWidth: 2 }]
                    },
                    options: {
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: { boxWidth: 12, boxHeight: 12, useBorderRadius: true, borderRadius: 2 }
                            },
                            tooltip: {
                                callbacks: {
                                    label: function (ctx) {
                                        var total = ctx.dataset.data.reduce(function (a, b) { return a + b; }, 0);
                                        var share = Math.round((ctx.parsed / total) * 100);
                                        return ctx.label + ': ' + ctx.parsed + ' applicants (' + share + '%)';
                                    }
                                }
                            }
                        }
                    }
                });
            }

            function renderTopScores(rows) {
                topTable.clear();
                topTable.rows.add(rows.map(function (t, i) {
                    return [
                        i + 1,
                        esc(t.applicantName),
                        esc(t.studentNo),
                        esc(t.firstChoice || '—'),
                        t.score,
                        '<span class="badge rounded-pill ' + esc(t.statusBadgeClass) + '">' + esc(t.status) + '</span>',
                        esc(t.dateLabel)
                    ];
                }));
                topTable.draw();
            }

            // One entry per chart or table card with a date filter; the stat tiles above always show the overall figures. `render` draws that card from its own response; `filtered` says
            // whether a range is applied, which only changes the wording of an empty state.
            var NO_DATA = 'No data for the selected dates.';
            var CARDS = {
                trend: {
                    render: function (d, filtered) {
                        renderBar('applicantTrendChart', d.rows, {
                            seriesLabel: 'New applicants', unit: 'applicants',
                            emptyMessage: filtered ? NO_DATA : 'No applicants registered in the last 12 months.'
                        });
                    }
                },
                scores: {
                    render: function (d, filtered) {
                        renderBar('scoreDistributionChart', d.rows, {
                            seriesLabel: 'Attempts', unit: 'attempts', histogram: true,
                            emptyMessage: filtered ? NO_DATA : 'No exam attempts recorded yet.'
                        });
                    }
                },
                departments: {
                    render: function (d, filtered) {
                        renderChoices(d.rows, filtered ? NO_DATA : 'No applicants have picked a department yet.');
                    }
                },
                yearLevels: {
                    render: function (d, filtered) {
                        renderYearLevels(d.rows, filtered ? NO_DATA : 'No applicants registered yet.');
                    }
                },
                top: { render: function (d) { renderTopScores(d.rows); } }
            };

            // Question bank charts don't depend on dates, so they are drawn once.
            renderBar('questionSectionChart', @Json.Serialize(Model.QuestionsPerSection), {
                seriesLabel: 'Questions', unit: 'questions',
                emptyMessage: 'No questions have been added to sections yet.'
            });
            renderBar('questionTypeChart', @Json.Serialize(Model.QuestionsPerType), {
                seriesLabel: 'Questions', unit: 'questions',
                emptyMessage: 'No questions have been added yet.'
            });

            // The cards drawn from chart data start from the unfiltered figures the server rendered with the page.
            CARDS.trend.render({ rows: @Json.Serialize(Model.ApplicantsPerMonth) }, false);
            CARDS.scores.render({ rows: @Json.Serialize(Model.ScoreDistribution) }, false);
            CARDS.departments.render({ rows: @Json.Serialize(Model.DepartmentChoices) }, false);
            CARDS.yearLevels.render({ rows: @Json.Serialize(Model.ApplicantsPerYearLevel) }, false);

            function formatDay(value, withYear) {
                var options = { month: 'short', day: 'numeric' };
                if (withYear) { options.year = 'numeric'; }
                return new Date(value + 'T00:00:00').toLocaleDateString('en-US', options);
            }

            // Short text for the button, e.g. "Oct 27 – Oct 28"; the year only shows when it isn't this year.
            function describe(from, to) {
                var thisYear = String(new Date().getFullYear());
                var withYear = [from, to].some(function (v) { return v && v.slice(0, 4) !== thisYear; });
                if (from && to) { return formatDay(from, withYear) + ' – ' + formatDay(to, withYear); }
                if (from) { return 'From ' + formatDay(from, withYear); }
                if (to) { return 'Up to ' + formatDay(to, withYear); }
                return 'All dates';
            }

            // Every card owns its filter: its own dates, its own request, its own loading and error state.
            document.querySelectorAll('.card-filter').forEach(function (filter) {
                var card = CARDS[filter.dataset.card];
                var host = filter.closest('.card');
                var target = host.querySelector('[data-filter-target]');
                var toggle = filter.querySelector('.card-filter-toggle');
                var label = filter.querySelector('.card-filter-label');
                var fromInput = filter.querySelector('[data-role="from"]');
                var toInput = filter.querySelector('[data-role="to"]');
                var resetButton = filter.querySelector('[data-role="reset"]');
                var errorLine = filter.querySelector('[data-role="error"]');
                var pending = null;
                var inFlight = null;

                function setError(message) {
                    errorLine.textContent = message || '';
                    toggle.classList.toggle('is-error', !!message);
                }

                function refresh() {
                    var from = fromInput.value;
                    var to = toInput.value;
                    var active = !!(from || to);

                    fromInput.max = to;
                    toInput.min = from;
                    resetButton.disabled = !active;
                    label.textContent = describe(from, to);
                    toggle.classList.toggle('is-active', active);
                    toggle.title = active ? 'Filtered: ' + label.textContent : 'Filter by date';

                    if (from && to && from > to) {
                        setError('The start date must be on or before the end date.');
                        return;
                    }
                    setError('');

                    if (inFlight) { inFlight.abort(); }
                    var request = inFlight = new AbortController();

                    var params = new URLSearchParams({ handler: 'Data', card: filter.dataset.card, tzOffset: new Date().getTimezoneOffset() });
                    if (from) { params.set('from', from); }
                    if (to) { params.set('to', to); }

                    target.classList.add('is-loading');
                    fetch('?' + params.toString(), {
                        headers: { Accept: 'application/json' },
                        credentials: 'same-origin',
                        signal: request.signal
                    })
                        .then(function (response) {
                            if (!response.ok) { throw new Error('Request failed'); }
                            return response.json();
                        })
                        .then(function (data) { card.render(data, active); })
                        .catch(function (error) {
                            if (error.name === 'AbortError') { return; }
                            setError('Couldn’t load this card. Try again.');
                        })
                        .finally(function () {
                            if (inFlight === request) {
                                inFlight = null;
                                target.classList.remove('is-loading');
                            }
                        });
                }

                function scheduleRefresh() {
                    clearTimeout(pending);
                    pending = setTimeout(refresh, 250);
                }

                fromInput.addEventListener('change', scheduleRefresh);
                toInput.addEventListener('change', scheduleRefresh);
                resetButton.addEventListener('click', function () {
                    fromInput.value = '';
                    toInput.value = '';
                    refresh();
                });
                filter.querySelector('form').addEventListener('submit', function (e) { e.preventDefault(); });
            });
        });
    </script>
}
