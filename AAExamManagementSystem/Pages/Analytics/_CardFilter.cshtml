@model AAExamManagementSystem.Pages.Analytics.IndexModel.CardFilter

<div class="dropdown card-filter" data-card="@Model.Card">
    <button type="button" class="btn btn-sm btn-light border card-filter-toggle" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" title="Filter by date">
        <i class="bi bi-calendar3" aria-hidden="true"></i>
        <span class="card-filter-label">All dates</span>
    </button>
    <form class="dropdown-menu dropdown-menu-end p-3 card-filter-menu" novalidate>
        <label class="d-block small fw-semibold mb-2">
            From
            <input type="date" class="form-control form-control-sm mt-1" data-role="from" />
        </label>
        <label class="d-block small fw-semibold mb-2">
            To
            <input type="date" class="form-control form-control-sm mt-1" data-role="to" />
        </label>
        <p class="small text-muted mb-3">@Model.Hint</p>
        <div class="d-flex justify-content-between align-items-center gap-2">
            <small class="text-danger" role="alert" data-role="error"></small>
            <button type="button" class="btn btn-sm btn-outline-secondary ms-auto" data-role="reset" disabled>Reset</button>
        </div>
    </form>
</div>
