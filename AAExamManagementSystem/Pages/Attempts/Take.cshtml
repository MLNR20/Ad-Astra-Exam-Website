@page
@model AAExamManagementSystem.Pages.Attempts.TakeModel
@using AAExamManagementSystem.Models.Entities
@using AAExamManagementSystem.Services
@{
    ViewData["Title"] = "Take Exam";
    Layout = "_ExamLayout";

    // Each page shows its own department's hero, like the editor preview: the exam's department, then General Knowledge.
    var heroDepartment = string.IsNullOrEmpty(Model.StageHeroDepartment) ? Model.SectionName : Model.StageHeroDepartment;
    var heroTitle = string.IsNullOrEmpty(Model.StageTitle) ? $"{Model.SectionName ?? "Qualifying"} Exam" : Model.StageTitle;
    var heroSubtitle = string.IsNullOrEmpty(Model.StageSubtitle) ? "This exam can only be taken once." : Model.StageSubtitle;
}

<div class="exam-sim-hero d-flex flex-column align-items-center justify-content-center text-center px-3" style="background-image: url('@Url.Content(ExamHeroImage.For(heroDepartment))')">
    <div class="exam-sim-hero-overlay"></div>
    <div class="exam-sim-hero-content">
        <h1 class="exam-sim-hero-title text-white fw-bold">@heroTitle</h1>
        <p class="exam-sim-hero-subtitle text-white mb-0">@heroSubtitle</p>
    </div>
</div>

<div class="py-4 px-0">
    <div class="signup-wizard-wrapper mx-auto w-100 px-3">
        @if (!Model.HasApplicantProfile)
        {
            <div class="alert alert-warning">No applicant profile is linked to this account.</div>
            <a asp-page="/ApplicantPortal" class="btn btn-outline-secondary">Back to Applicant Portal</a>
        }
        else if (Model.AlreadyAttempted)
        {
            <div class="alert alert-info">
                @if (Model.SubmittedScore.HasValue)
                {
                    <p class="fs-5 mb-1">You scored @Model.SubmittedScore out of @Model.SubmittedMaxScore.</p>
                }
                <p class="mb-0">You have already taken this exam. Your attempt is awaiting review.</p>
            </div>
            <a asp-page="/ApplicantPortal" class="btn btn-outline-secondary">Back to Applicant Portal</a>
        }
        else if (Model.TotalPages == 0)
        {
            <p class="fs-5 mb-3">
                No active exam questions are available right now for your first choice
                (@(Model.FirstChoice ?? "not set")) or second choice (@(Model.SecondChoice ?? "not set")).
                Please check back later or contact Ad Astra.
            </p>
            <a asp-page="/ApplicantPortal" class="btn btn-outline-secondary">Back to Applicant Portal</a>
        }
        else
        {
            @if (Model.SubmittedScore.HasValue)
            {
                <div class="alert alert-success">
                    Your previous exam is submitted: you scored @Model.SubmittedScore out of @Model.SubmittedMaxScore.
                    Your next exam is below.
                </div>
            }
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <p class="mb-0">@error.ErrorMessage</p>
                    }
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.ExamError))
            {
                <div class="alert alert-danger">@Model.ExamError</div>
            }

            @await Html.PartialAsync("_ExamPageCounter", (Current: Model.CurrentPage, Total: Model.TotalPages))

            <div class="signup-wizard-card w-100">
            <form method="post" id="examForm">
                <input type="hidden" name="pageNum" value="@Model.CurrentPage" />
                @await Html.PartialAsync("_ExamQuestionHeader", (
                    Heading: Model.CurrentPageHeading,
                    Subheading: Model.CurrentPageSubheading))

                @for (var qi = 0; qi < Model.CurrentPageQuestions.Count; qi++)
                {
                    var question = Model.CurrentPageQuestions[qi];
                    var selectedChoiceId = Model.Answers.GetValueOrDefault(question.Id);
                    var existingText = Model.AnswerTexts.GetValueOrDefault(question.Id, string.Empty);
                    var isEssay = question.QuestionTypeName == QuestionTypes.Essay;
                    var imageName = question.Image ?? string.Empty;
                    var isSqlQuestion = imageName.Contains("sql-schema");
                    var isDebugQuestion = imageName.Contains("debug-");
                    var isWideImage = isSqlQuestion || isDebugQuestion;
                    if (Model.SectionHeadings.TryGetValue(question.Id, out var sectionHeading))
                    {
                        @await Html.PartialAsync("_ExamSectionHeading", (sectionHeading.Instruction, sectionHeading.SubInstruction))
                    }
                    <div class="d-flex flex-column mt-2">
                    <div class="exam-sim-question mb-4">
                        <h5 class="fw-semibold mb-3">@(qi + 1). @question.QuestionTitle</h5>
                        @if (!string.IsNullOrEmpty(question.Image))
                        {
                            var imageClass = isWideImage
                                ? "exam-sim-question-image exam-sim-question-image-wide img-fluid rounded mt-3 mb-3 d-block mx-auto"
                                : "exam-sim-question-image img-fluid rounded mt-3 mb-3 d-block mx-auto";
                            <img src="@question.Image" class="@imageClass" alt="" />
                        }
                        <div class="exam-sim-choices mt-2">
                            @if (QuestionTypes.RequiresChoices(question.QuestionTypeName))
                            {
                                @for (var ci = 0; ci < question.Choices.Count; ci++)
                                {
                                    var choice = question.Choices[ci];
                                    <div class="form-check exam-sim-choice mb-3">
                                        <input class="form-check-input" type="radio" name="Answers[@question.Id]" id="q@(qi)_c@(ci)" value="@choice.Id" required checked="@(choice.Id == selectedChoiceId)" />
                                        <label class="form-check-label" for="q@(qi)_c@(ci)">@choice.ChoiceText</label>
                                    </div>
                                }
                            }
                            else if (isEssay)
                            {
                                <textarea class="form-control exam-sim-input exam-sim-essay" name="AnswerTexts[@question.Id]" rows="6" placeholder="Type your answer" autocomplete="off" required>@existingText</textarea>
                            }
                            else if (isSqlQuestion || isDebugQuestion)
                            {
                                <textarea class="form-control exam-sim-input exam-sim-input-sql" name="AnswerTexts[@question.Id]" rows="@(isSqlQuestion ? 6 : 3)" placeholder="@(isSqlQuestion ? "Type your SQL query" : "Type the line numbers that have an error")" autocomplete="off" spellcheck="false" required>@existingText</textarea>
                            }
                            else
                            {
                                <input type="text" class="form-control exam-sim-input" name="AnswerTexts[@question.Id]" value="@existingText" placeholder="Type your answer" autocomplete="off" required />
                            }
                        </div>
                    </div>
                    </div>
                }

                <div class="d-flex align-items-center gap-2 mt-5 mb-5">
                    @if (Model.CurrentPage > 1)
                    {
                        <button type="submit" name="direction" value="prev" formnovalidate class="btn btn-outline-secondary px-4">
                            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i> Previous
                        </button>
                    }
                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <button type="submit" name="direction" value="next" class="btn btn-dark px-4">
                            Next <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
                        </button>
                    }
                    else
                    {
                        <button type="submit" name="direction" value="submit" class="btn btn-dark px-4 signup-submit">
                            <i class="bi bi-send-check me-1" aria-hidden="true"></i> Submit Answers
                        </button>
                    }
                </div>

                <div class="alert alert-secondary">
                    <h2 class="h6 fw-bold mb-2">Instructions</h2>
                    <ul class="mb-0 ps-3">
                        <li>Answer every question on this page before continuing.</li>
                        <li>You can go back to a previous page to review your answers.</li>
                        <li>Once you submit the final page, your answers are final and cannot be changed.</li>
                        <li>This exam can only be taken once.</li>
                    </ul>
                </div>
            </form>
            </div>
        }
    </div>
</div>

@section Styles {
    <style>
        .exam-sim-question-image {
            width: 19.5%;
        }

        .exam-sim-question-image-wide {
            width: 100%;
            max-width: 560px;
        }

        .exam-sim-choice .form-check-input,
        .exam-sim-input {
            border-color: #000;
        }

        .exam-sim-input {
            width: 100%;
        }

        .exam-sim-essay {
            width: 100%;
            height: 200px;
            resize: vertical;
        }

        .exam-sim-input-sql {
            width: 100%;
            height: 200px;
            resize: vertical;
            font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        }

        .exam-sim-hero {
            position: relative;
            height: 43vh;
            background-image: url('@Url.Content("~/images/general-knowledge-banner.webp")');
            background-size: cover;
            background-position: center;
            overflow: hidden;
        }

        .exam-sim-hero-overlay {
            position: absolute;
            inset: 0;
            background: rgba(0, 0, 0, 0.55);
        }

        .exam-sim-hero-content {
            position: relative;
            z-index: 1;
            max-width: 640px;
        }

        .exam-sim-hero-title {
            font-size: 3.5rem;
            letter-spacing: -0.02rem;
            margin-bottom: 0.7rem;
        }

        .exam-sim-hero-subtitle {
            font-size: 1.25rem;
            opacity: 0.9;
        }
    </style>
}
