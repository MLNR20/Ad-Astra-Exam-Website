@page
@model AAExamManagementSystem.Pages.Attempts.SubmittedModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Exam Submitted - Exam Management System</title>
    <link rel="icon" type="image/png" href="~/images/adastra-mark.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <nav class="navbar navbar-light bg-white shadow-sm mb-0 site-navbar">
        <div class="container-fluid d-flex align-items-center justify-content-between px-5">
            <a asp-page="/Index" class="navbar-brand d-flex align-items-center gap-2 mb-0">
                <img src="~/images/adastra-mark.png" alt="" class="signup-navbar-mark" />
                <span class="fw-semibold">AD ASTRA</span>
            </a>
            <div class="d-flex align-items-center gap-2">
                <a asp-page="/ApplicantPortal" class="btn btn-dark fw-semibold">My Portal</a>
            </div>
        </div>
    </nav>

    <main class="signup-success d-flex align-items-center justify-content-center flex-grow-1 p-3">
        <div class="signup-success-card text-center w-100">
            <img src="~/images/adastra-mark.png" alt="Ad Astra" class="signup-success-logo mb-4" />
            <h1 class="h3 fw-bold mb-3">Your exam has been submitted</h1>
            <p class="signup-subtitle text-muted mb-2">
                Thank you. Your @Model.SectionName exam has been submitted and is awaiting review.
            </p>
            @if (!string.IsNullOrEmpty(Model.SubmittedAt))
            {
                <p class="text-muted mb-2">Submitted on <strong>@Model.SubmittedAt</strong></p>
            }
            @if (Model.HasNextExam)
            {
                <p class="text-muted mb-4">You have another exam waiting for you.</p>
                <a asp-page="/Attempts/Take" class="btn btn-dark px-4 signup-submit">
                    Continue to my next exam <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
                </a>
                <div class="mt-3">
                    <a asp-page="@Model.ContinuePage" class="text-muted">Back to my dashboard</a>
                </div>
            }
            else
            {
                <div class="mb-4"></div>
                <a asp-page="@Model.ContinuePage" class="btn btn-dark px-4 signup-submit">
                    Continue to my dashboard <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
                </a>
            }
        </div>
    </main>

    @await Html.PartialAsync("_AdAstraFooter")
</body>
</html>
