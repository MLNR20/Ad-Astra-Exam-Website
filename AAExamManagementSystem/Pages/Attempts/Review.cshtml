@page "{id:int}"
@model AAExamManagementSystem.Pages.Attempts.ReviewModel
@{
    ViewData["Title"] = "Review Attempt";
}

@if (Model.Attempt is null)
{
    <p>Attempt not found.</p>
}
else
{
    var attempt = Model.Attempt;
    <form method="post" asp-page-handler="Approve" asp-route-id="@attempt.Id">
        <div class="card border rounded-2 p-4 mb-3">
            <div class="card-header bg-transparent px-0 py-3">
                <h1 class="h4 fw-bold mb-0">Review Attempt</h1>
            </div>
            <div class="card-body px-0 py-3">
                <dl class="row g-3 mb-0">
                    <div class="col-sm-6 col-lg-4">
                        <dt class="small text-muted fw-normal">Applicant</dt>
                        <dd class="mb-0 fw-semibold">@attempt.ApplicantName (@attempt.StudentNo)</dd>
                    </div>
                    <div class="col-sm-6 col-lg-4">
                        <dt class="small text-muted fw-normal">Section</dt>
                        <dd class="mb-0 fw-semibold">@(attempt.Section ?? "-")</dd>
                    </div>
                    <div class="col-sm-6 col-lg-4">
                        <dt class="small text-muted fw-normal">Date Taken</dt>
                        <dd class="mb-0 fw-semibold">@(attempt.DateTaken ?? "-")</dd>
                    </div>
                    <div class="col-sm-6 col-lg-4">
                        <dt class="small text-muted fw-normal">Score</dt>
                        <dd class="mb-0 fw-semibold">@attempt.TotalScore / @attempt.MaxScore</dd>
                    </div>
                    <div class="col-sm-6 col-lg-4">
                        <dt class="small text-muted fw-normal">Status</dt>
                        <dd class="mb-0">
                            @if (attempt.IsApproved)
                            {
                                <span class="badge bg-success">Approved by @attempt.ApprovedBy</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Pending Approval</span>
                            }
                        </dd>
                    </div>
                </dl>
            </div>

            @if (Model.IsReadOnly)
            {
                <div class="border-top px-0 py-2 small text-muted" role="note">
                    Viewing as an administrator. Grading and approval are done by editors.
                </div>
            }

        <fieldset disabled="@Model.IsReadOnly" class="border-0 p-0 m-0 min-w-0">
        <div class="table-responsive border-top">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Question</th>
                        <th>Answer</th>
                        <th>Correct?</th>
                        <th style="width:120px">Points</th>
                        <th>Checked By</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < attempt.Answers.Count; i++)
                    {
                        var answer = attempt.Answers[i];
                        <tr>
                            <td>@(i + 1)</td>
                            <td>@answer.QuestionTitle</td>
                            <td>@(string.IsNullOrEmpty(answer.AnswerText) ? "(no answer)" : answer.AnswerText)</td>
                            <td>
                                <select name="Corrections[@answer.Id]" class="form-select form-select-sm">
                                    <option value="Yes" selected="@(answer.IsCorrect == "Yes")">Yes</option>
                                    <option value="No" selected="@(answer.IsCorrect != "Yes")">No</option>
                                </select>
                            </td>
                            <td>
                                <input type="number" name="Points[@answer.Id]" value="@answer.Point" min="0" max="@answer.MaxScore" step="1"
                                       class="form-control form-control-sm"
                                       oninput="if(this.value !== '' && Number(this.value) > Number(this.max)) this.value = this.max; if(this.value !== '' && Number(this.value) < 0) this.value = 0;" />
                                <div class="form-text">Max @answer.MaxScore</div>
                            </td>
                            <td>@(answer.CheckedBy ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        </fieldset>
        </div>

        <div class="page-action-bar d-flex justify-content-between align-items-center">
            <a asp-page="/Attempts/Index" class="btn btn-outline-secondary">Back to Attempts</a>
            @if (!Model.IsReadOnly)
            {
                <button type="submit" class="btn btn-primary">@(attempt.IsApproved ? "Re-approve" : "Approve Attempt")</button>
            }
        </div>
    </form>
}
