@page "{id:int}"
@model AAExamManagementSystem.Pages.Attempts.MyAttemptDetailsModel
@{
    ViewData["Title"] = "My Attempt";
    Layout = "_ApplicantLayout";

    (string Text, long Order) TakenOn(string? value) =>
        DateTime.TryParse(value, null, System.Globalization.DateTimeStyles.RoundtripKind, out var taken)
            ? (LocalTime.Of(taken).ToString("MMM d, yyyy h:mm tt"), taken.Ticks)
            : (value ?? "-", 0L);
}

@if (Model.Attempt is null)
{
    <p>Attempt not found.</p>
}
else
{
    var attempt = Model.Attempt;
    <h1 class="h4 fw-bold mb-4">My Attempt</h1>

    <div class="alert alert-success d-flex align-items-center gap-2" role="status">
        <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
        <span>Your exam has been submitted.</span>
    </div>

    <div class="card border rounded-2 p-3 mb-4">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Section</dt>
                <dd class="col-sm-9">@(attempt.Section ?? "-")</dd>

                <dt class="col-sm-3">Date Taken</dt>
                <dd class="col-sm-9">@TakenOn(attempt.DateTaken).Text</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9 mb-0"><span class="badge rounded-pill text-bg-success">Submitted</span></dd>
            </dl>
        </div>
    </div>

    <div class="table-responsive mb-4">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Question</th>
                    <th>Your Answer</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < attempt.Answers.Count; i++)
                {
                    var answer = attempt.Answers[i];
                    <tr>
                        <td>@(i + 1)</td>
                        <td>@answer.QuestionTitle</td>
                        <td>@(string.IsNullOrEmpty(answer.AnswerText) ? "(no answer)" : answer.AnswerText)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <a asp-page="/Attempts/MyAttempts" class="btn btn-outline-secondary">Back to My Attempts</a>
}
