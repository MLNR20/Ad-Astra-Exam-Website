@page
@model AAExamManagementSystem.Pages.Applicants.IndexModel
@{
    ViewData["Title"] = "Applicants";
}

<div class="card border rounded-2 p-4">
    <div class="card-header bg-white border-bottom-0">
        <h5 class="mb-0 entity-table-title table-heading-sm">
            Applicants@(string.IsNullOrEmpty(Model.DepartmentName) ? "" : $" — {Model.DepartmentName}")
        </h5>
    </div>
    <div class="card-body">
        @if (!Model.IsAdmin && string.IsNullOrEmpty(Model.DepartmentName))
        {
            <div class="alert alert-warning mb-0" role="alert">Your account isn't assigned to a department yet. Ask an administrator to assign one.</div>
        }
        else if (Model.Applicants.Count == 0)
        {
            <div class="alert alert-info mb-0" role="alert">No applicants have applied@(Model.IsAdmin ? "" : " to your department") yet.</div>
        }
        else
        {
            <table id="applicantsTable" class="table table-striped table-hover align-middle w-100">
                <thead>
                    <tr>
                        <th class="text-start">Applicant</th>
                        <th class="text-start">Student No.</th>
                        <th class="text-start">Email</th>
                        <th class="text-start">Academic Year</th>
                        <th class="text-start">Year Level</th>
                        <th class="text-start">School</th>
                        <th class="text-start">Scholar</th>
                        <th class="text-start">1st Choice</th>
                        <th class="text-start">2nd Choice</th>
                        <th class="text-start">Exams</th>
                        <th class="text-start">Expected Graduation</th>
                        <th class="text-start">Terms Left</th>
                        <th class="text-start">Resume</th>
                        <th class="text-start">Applied</th>
                        <th class="text-start">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var applicant in Model.Applicants)
                    {
                        <tr>
                            <td class="text-start">@applicant.FullName</td>
                            <td class="text-start">@applicant.StudentNo</td>
                            <td class="text-start">@applicant.Email</td>
                            <td class="text-start">@applicant.AcademicYear</td>
                            <td class="text-start">@(applicant.YearLevel ?? "-")</td>
                            <td class="text-start">@(applicant.School ?? "-")</td>
                            <td class="text-start">@(applicant.IsScholar ? "Yes" : "No")</td>
                            <td class="text-start">@(applicant.FirstChoice ?? "-")</td>
                            <td class="text-start">@(applicant.SecondChoice ?? "-")</td>
                            <td class="text-start">@(applicant.AppliedSections.Count > 0 ? string.Join(", ", applicant.AppliedSections) : "-")</td>
                            <td class="text-start">@(applicant.ExpectedGradDate ?? "-")</td>
                            <td class="text-start">@applicant.TermsRemaining</td>
                            <td class="text-start">
                                @if (!string.IsNullOrWhiteSpace(applicant.Resume)
                                    && Uri.TryCreate(applicant.Resume, UriKind.Absolute, out var resumeUri)
                                    && (resumeUri.Scheme == Uri.UriSchemeHttp || resumeUri.Scheme == Uri.UriSchemeHttps))
                                {
                                    <a href="@resumeUri.AbsoluteUri" target="_blank" rel="noopener noreferrer">View</a>
                                }
                                else
                                {
                                    @(string.IsNullOrWhiteSpace(applicant.Resume) ? "-" : applicant.Resume)
                                }
                            </td>
                            <td class="text-start" data-order="@applicant.DateApplied.Ticks">@LocalTime.Of(applicant.DateApplied).ToString("MMM d, yyyy")</td>
                            <td class="text-start">
                                <div class="d-flex gap-1">
                                    <a asp-page="/Applicants/Details" asp-route-id="@applicant.Id" class="btn btn-primary">Details</a>
                                    @if (Model.IsAdmin)
                                    {
                                        <form method="post" asp-page-handler="Archive" asp-route-id="@applicant.Id"
                                              onsubmit="return confirm('Archive @applicant.FullName.Replace("'", "\\'")? They will be hidden and unable to log in.');">
                                            <button type="submit" class="btn btn-danger">Delete</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
}

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(function () {
            if ($('#applicantsTable').length) {
                initEntityTable('applicantsTable', { order: [] });
            }
        });
    </script>
}
