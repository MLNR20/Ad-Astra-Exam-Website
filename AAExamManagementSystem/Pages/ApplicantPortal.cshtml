@page
@model ApplicantPortalModel
@using AAExamManagementSystem.Models.Entities
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_ApplicantLayout";

    // "in 3 days", "in 2 hours", "in 15 minutes" for an exam that hasn't started yet.
    string OpensIn(DateTime start)
    {
        var left = start - DateTime.Now;
        if (left.TotalDays >= 1) return $"in {(int)left.TotalDays} day{((int)left.TotalDays == 1 ? "" : "s")}";
        if (left.TotalHours >= 1) return $"in {(int)left.TotalHours} hour{((int)left.TotalHours == 1 ? "" : "s")}";
        return $"in {Math.Max(1, (int)left.TotalMinutes)} minutes";
    }

    var next = Model.PendingAttempts.FirstOrDefault();
}

@if (Model.Applicant is null)
{
    <div class="alert alert-warning">
        No applicant profile is linked to this account.
    </div>
}
else
{
    <section class="bg-black text-white rounded-4 p-4 p-md-5 mb-4">
        <div class="row g-4 align-items-center">
            <div class="col-12 col-lg-7">
                <span class="d-block fs-5 fw-normal text-white-50 mb-1">Welcome back,</span>
                <h1 class="display-6 fw-bold mb-3">@Model.Applicant.FirstName @Model.Applicant.LastName</h1>
                <p class="text-white-50 mb-0 fs-5">
                    @if (next is not null)
                    {
                        @:You have @Model.PendingAttempts.Count upcoming @(Model.PendingAttempts.Count == 1 ? "exam" : "exams"). Good luck!
                    }
                    else if (Model.LatestAttempt is { IsApproved: true })
                    {
                        @:Your results are in. Check your score below.
                    }
                    else if (Model.AttemptCount > 0)
                    {
                        @:Your exam has been submitted and is awaiting review.
                    }
                    else
                    {
                        @:Ready to start? Apply to a department to book your exam.
                    }
                </p>
            </div>
            @if (next is null)
            {
                <div class="col-12 col-lg-5 text-lg-end">
                    <a asp-page="/Returning" class="btn btn-light fw-semibold">
                        <i class="bi bi-arrow-repeat me-1" aria-hidden="true"></i> Apply again
                    </a>
                </div>
            }
        </div>
    </section>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-5 g-3 mb-4">
        <div class="col">
            <div class="card border rounded-3 h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="stat-icon bg-success text-white rounded-3" aria-hidden="true"><i class="bi bi-check-circle"></i></span>
                    <div>
                        <div class="fs-2 fw-bold lh-1">@Model.ApplicationCount</div>
                        <div class="text-muted">@(Model.Applicant.IsActive ? "Active" : "Inactive") @(Model.ApplicationCount == 1 ? "application" : "applications")</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card border rounded-3 h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="stat-icon bg-secondary text-white rounded-3" aria-hidden="true"><i class="bi bi-mortarboard"></i></span>
                    <div class="overflow-hidden">
                        <div class="fs-5 fw-bold lh-sm text-truncate">@(Model.FirstChoice ?? "—")</div>
                        <div class="text-muted">First choice</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card border rounded-3 h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="stat-icon bg-info text-white rounded-3" aria-hidden="true"><i class="bi bi-mortarboard-fill"></i></span>
                    <div class="overflow-hidden">
                        <div class="fs-5 fw-bold lh-sm text-truncate">@(Model.SecondChoice ?? "—")</div>
                        <div class="text-muted">Second choice</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card border rounded-3 h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="stat-icon bg-warning text-white rounded-3" aria-hidden="true"><i class="bi bi-pencil-square"></i></span>
                    <div>
                        <div class="fs-2 fw-bold lh-1">@Model.AttemptCount</div>
                        <div class="text-muted">Exams taken</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card border rounded-3 h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="stat-icon bg-primary text-white rounded-3" aria-hidden="true"><i class="bi bi-graph-up"></i></span>
                    <div>
                        @if (Model.LatestAttempt is null)
                        {
                            <div class="fs-2 fw-bold lh-1">—</div>
                            <div class="text-muted">Latest score</div>
                        }
                        else if (!Model.LatestAttempt.IsApproved)
                        {
                            <div class="fs-5 fw-bold lh-sm">Pending</div>
                            <div class="text-muted">Latest score</div>
                        }
                        else
                        {
                            <div class="fs-2 fw-bold lh-1">@Model.LatestAttempt.TotalScore / @Model.LatestAttempt.MaxScore</div>
                            <div class="text-muted">Latest score</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <section class="card border rounded-2 p-4">
        <div class="card-header bg-white border-bottom-0">
            <h5 class="mb-0 entity-table-title fw-bold">Your exams</h5>
            @if (Model.PendingAttempts.Count > 0)
            {
                <p class="text-muted mt-2 mb-0">One exam for each department you picked. Each has its own password, and opens at its booked time.</p>
            }
        </div>
        <div class="card-body">
            @if (Model.AttemptCount > 0)
            {
                <div class="mb-3">
                    <a asp-page="/Attempts/MyAttempts" class="btn btn-primary">
                        <i class="bi bi-clipboard-check me-1" aria-hidden="true"></i> View my attempts
                    </a>
                </div>
            }

            @if (Model.PendingAttempts.Count == 0)
            {
                <div class="text-center text-muted py-4">
                    <i class="bi bi-calendar-check fs-1 d-block mb-2" aria-hidden="true"></i>
                    <p class="mb-3">No upcoming exams. Apply to another department to book one.</p>
                    <a asp-page="/Returning" class="btn btn-dark">
                        <i class="bi bi-arrow-repeat me-1" aria-hidden="true"></i> Apply again
                    </a>
                </div>
            }
            else
            {
                <table id="upcomingExamsTable" class="table table-striped table-hover align-middle w-100">
                    <thead>
                        <tr>
                            <th class="text-start">Department</th>
                            <th class="text-start">Schedule</th>
                            <th class="text-start">Password</th>
                            <th class="text-start">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var exam in Model.PendingAttempts)
                        {
                            <tr>
                                <td class="text-start fw-bold">@(exam.Section ?? "Exam")</td>
                                <td class="text-start" data-order="@(exam.ScheduledStart?.Ticks ?? long.MaxValue)">
                                    @if (exam.ScheduledStart is { } when)
                                    {
                                        @when.ToString("MMM d, yyyy")
                                        <div class="text-muted small">@ExamSchedule.FormatSlot(TimeOnly.FromDateTime(when))</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">No time booked</span>
                                    }
                                </td>
                                <td class="text-start" data-order="@(exam.Password ?? "")">
                                    <div class="d-flex align-items-center gap-2">
                                        <code class="fs-6">@(exam.Password ?? "-")</code>
                                        @if (!string.IsNullOrEmpty(exam.Password))
                                        {
                                            <button type="button" class="btn btn-sm btn-light border copy-password" data-password="@exam.Password" aria-label="Copy password for @exam.Section" title="Copy password">
                                                <i class="bi bi-clipboard" aria-hidden="true"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                                <td class="text-start">
                                    @if (exam.IsOpen && exam == next)
                                    {
                                        <a asp-page="/Attempts/Take" class="btn btn-dark btn-sm">
                                            <i class="bi bi-pencil-square me-1" aria-hidden="true"></i> Take exam
                                        </a>
                                    }
                                    else if (exam.IsOpen)
                                    {
                                        <span class="badge text-bg-success">Open now</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">Opens @OpensIn(exam.ScheduledStart!.Value)</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </section>
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
}

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(function () {
            if ($('#upcomingExamsTable').length) {
                initEntityTable('upcomingExamsTable', { order: [[1, 'asc']], columnDefs: [{ orderable: false, targets: [3] }] });
            }
        });

        // Delegated so the copy buttons keep working after DataTables redraws the rows (sorting, paging, search).
        document.addEventListener('click', function (event) {
            var button = event.target.closest('.copy-password');
            if (!button) return;
            var icon = button.querySelector('i');
            navigator.clipboard.writeText(button.dataset.password).then(function () {
                icon.classList.replace('bi-clipboard', 'bi-clipboard-check');
                setTimeout(function () { icon.classList.replace('bi-clipboard-check', 'bi-clipboard'); }, 1500);
            });
        });
    </script>
}
