@page
@model AAExamManagementSystem.Pages.Staff.IndexModel
@{
    ViewData["Title"] = "Department Staff";
}

<div class="card border rounded-2 p-4">
    <div class="card-header bg-white border-bottom-0 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 entity-table-title">
            <i class="bi bi-people" aria-hidden="true"></i>
            Department Staff@(string.IsNullOrEmpty(Model.DepartmentName) ? "" : $" — {Model.DepartmentName}")
        </h5>
        @if (!string.IsNullOrEmpty(Model.DepartmentName))
        {
            <a asp-page="Create" class="btn btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add Staffer</a>
        }
    </div>
    <div class="card-body">
        @if (string.IsNullOrEmpty(Model.DepartmentName))
        {
            <div class="alert alert-warning mb-0" role="alert">Your account isn't assigned to a department yet. Ask an administrator to assign one.</div>
        }
        else if (Model.Staff.Count == 0)
        {
            <div class="alert alert-info mb-0" role="alert">No staff found in your department.</div>
        }
        else
        {
            <table id="staffTable" class="table table-striped table-hover align-middle w-100">
                <thead>
                    <tr>
                        <th class="text-start">Name</th>
                        <th class="text-start">Username</th>
                        <th class="text-start">Email</th>
                        <th class="text-start">Roles</th>
                        <th class="text-start">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var member in Model.Staff)
                    {
                        <tr>
                            <td class="text-start">@member.FullName@(member.Id == Model.CurrentUserId ? " (you)" : "")</td>
                            <td class="text-start">@member.UserName</td>
                            <td class="text-start">@member.Email</td>
                            <td class="text-start">@member.Role</td>
                            <td class="text-start">@await Component.InvokeAsync("StatusPill", new { isActive = member.IsActive })</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
}

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(function () {
            if ($('#staffTable').length) {
                initEntityTable('staffTable');
            }
        });
    </script>
}
