@page "{id:guid}"
@model AAExamManagementSystem.Pages.Departments.EditModel
@{
    ViewData["Title"] = "Edit Department";
}

<edit-card title="Edit Department">
    <div class="row">
        <div class="col-md-4">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />
                <div class="mb-3">
                    <label asp-for="Department.Name" class="form-label"></label>
                    <input asp-for="Department.Name" class="form-control" />
                    <span asp-validation-for="Department.Name" class="text-danger"></span>
                </div>
                <div class="form-check form-switch mb-3">
                    <input asp-for="Department.IsActive" class="form-check-input" role="switch" />
                    <label asp-for="Department.IsActive" class="form-check-label"></label>
                </div>
                <div class="mb-3">
                    <label class="form-label">Sections</label>
                    @if (Model.SectionOptions.Count == 0)
                    {
                        <div class="form-text">There are no sections yet.</div>
                    }
                    @foreach (var option in Model.SectionOptions)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="SelectedSectionIds" value="@option.Id"
                                   id="section-@option.Id" checked="@option.Selected" disabled="@(option.OtherDepartment is not null)" />
                            <label class="form-check-label" for="section-@option.Id">
                                @option.Name
                                @if (option.OtherDepartment is not null)
                                {
                                    <span class="text-muted small">(in @option.OtherDepartment)</span>
                                }
                            </label>
                        </div>
                    }
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-page="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</edit-card>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
