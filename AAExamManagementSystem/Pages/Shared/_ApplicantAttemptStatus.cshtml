@* Applicant-facing status of a submitted attempt: Model is null until an editor approves it, then true (passed) or false (failed). *@
@model bool?

@if (Model is { } passed)
{
    <partial name="_AttemptOutcome" model="passed" />
}
else
{
    <span class="badge rounded-pill text-bg-secondary">Submitted &middot; Awaiting review</span>
}
