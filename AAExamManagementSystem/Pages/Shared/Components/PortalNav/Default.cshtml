@model IReadOnlyList<PortalNavViewComponent.NavItem>

<nav class="portal-nav" aria-label="Applicant sections">
    @foreach (var item in Model)
    {
        <a asp-area="" asp-page="@item.Page" class="portal-nav-item@(item.IsActive ? " active" : "")" aria-current="@(item.IsActive ? "page" : null)">
            <i class="bi @item.Icon" aria-hidden="true"></i>
            <span>@item.Label</span>
        </a>
    }
</nav>
