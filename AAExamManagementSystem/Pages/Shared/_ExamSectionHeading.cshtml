@model (string? Instruction, string? SubInstruction)

<div class="exam-section-heading d-flex flex-column gap-3 mb-4 py-3 px-0">
    @if (!string.IsNullOrWhiteSpace(Model.Instruction))
    {
        <h4 class="exam-question-header fw-extrabold mb-0">@Model.Instruction</h4>
    }
    @if (!string.IsNullOrWhiteSpace(Model.SubInstruction))
    {
        <h5 class="exam-question-subheader text-muted fw-normal mb-0">@Model.SubInstruction</h5>
    }
</div>
