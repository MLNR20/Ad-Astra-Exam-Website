@page
@model AAExamManagementSystem.Pages.PageSections.IndexModel
@{
    ViewData["Title"] = "Exam Pages";
}

<div class="card border rounded-2 p-4">
    <div class="card-header bg-white border-bottom-0">
        <h5 class="mb-0 fw-semibold entity-table-title">Exam Pages</h5>
    </div>
    <div class="card-body">
        @if (Model.IsAdmin)
        {
            <form method="get" class="row g-2 align-items-end mb-4">
                <div class="col-auto">
                    <label class="form-label">Department / Section</label>
                    <select name="SectionId" class="form-select" onchange="this.form.submit()">
                        <option value="">-- Select Section --</option>
                        @foreach (var sectionOption in Model.SelectableSections)
                        {
                            <option value="@sectionOption.Id" selected="@(Model.SectionId == sectionOption.Id)">@sectionOption.Name</option>
                        }
                    </select>
                </div>
            </form>
        }

        @if (Model.RequiresSectionSelection)
        {
            <div class="alert alert-info mb-0">Select a section above to manage its exam pages.</div>
        }
        else if (Model.NoDepartmentAssigned)
        {
            <div class="alert alert-warning mb-0">You don't have a department assigned, so you can't manage exam pages. Contact an administrator.</div>
        }
        else
        {
            <p class="text-muted">Bundling questions for <strong>@Model.CurrentSectionName</strong>. Pick a question type and a
                page number below to bundle all matching questions onto that page; applicants will see that page's questions,
                in the order shown, when they take the exam.</p>

            <div class="card mb-4">
                <div class="card-header fw-semibold">Bundle questions onto a page</div>
                <div class="card-body">
                    <form method="post" asp-page-handler="Bundle" class="row g-2 align-items-end">
                        <input type="hidden" asp-for="SectionId" />
                        <div class="col-auto">
                            <label class="form-label">Question Type</label>
                            <select name="questionTypeId" class="form-select" asp-items="Model.QuestionTypeOptions" required>
                                <option value="">-- Select Question Type --</option>
                            </select>
                        </div>
                        <div class="col-auto">
                            <label class="form-label">Page Number</label>
                            <input type="number" name="pageNumber" class="form-control" min="1" value="1" required style="width: 7rem;" />
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-primary">Bundle</button>
                        </div>
                    </form>
                </div>
            </div>

            @if (TempData["SuccessMessage"] is string successMessage)
            {
                <div class="alert alert-success">@successMessage</div>
            }
            @if (TempData["ErrorMessage"] is string errorMessage)
            {
                <div class="alert alert-danger">@errorMessage</div>
            }

            @foreach (var pageGroup in Model.Pages)
            {
                var items = pageGroup.ToList();
                var pageInstruction = items.FirstOrDefault()?.Instruction;
                var pageSubInstruction = items.FirstOrDefault()?.SubInstruction;
                <div class="card mb-4">
                    <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                        <span>Page @pageGroup.Key</span>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#addSectionModal-@pageGroup.Key">
                                Add Section
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#editInstructionModal-@pageGroup.Key">
                                Edit Instruction
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(pageInstruction) || !string.IsNullOrEmpty(pageSubInstruction))
                        {
                            <div class="mb-3">
                                @if (!string.IsNullOrEmpty(pageInstruction))
                                {
                                    <p class="fw-semibold mb-1">@pageInstruction</p>
                                }
                                @if (!string.IsNullOrEmpty(pageSubInstruction))
                                {
                                    <p class="text-muted mb-0">@pageSubInstruction</p>
                                }
                            </div>
                        }
                        <form method="post" asp-page-handler="Reorder">
                            <input type="hidden" asp-for="SectionId" />
                            <input type="hidden" name="pageNumber" value="@pageGroup.Key" />
                            @foreach (var sectionGroup in items.GroupBy(i => i.PageSectionId))
                            {
                                <h6 class="fw-semibold mt-3 mb-2 d-flex justify-content-between align-items-center">
                                    <span>
                                        <span class="text-muted small me-1">Section @sectionGroup.First().SectionNumber</span>
                                        <span class="badge bg-secondary">@sectionGroup.First().QuestionTypeName</span>
                                    </span>
                                    <span class="d-flex gap-2">
                                        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#sectionInstructionModal-@sectionGroup.Key">
                                            Edit Instruction
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#assignQuestionsModal-@sectionGroup.Key">
                                            Assign Questions
                                        </button>
                                    </span>
                                </h6>
                                @if (!string.IsNullOrEmpty(sectionGroup.First().SectionInstruction) || !string.IsNullOrEmpty(sectionGroup.First().SectionSubInstruction))
                                {
                                    <div class="mb-2">
                                        @if (!string.IsNullOrEmpty(sectionGroup.First().SectionInstruction))
                                        {
                                            <p class="fw-semibold mb-0">@sectionGroup.First().SectionInstruction</p>
                                        }
                                        @if (!string.IsNullOrEmpty(sectionGroup.First().SectionSubInstruction))
                                        {
                                            <p class="text-muted small mb-0">@sectionGroup.First().SectionSubInstruction</p>
                                        }
                                    </div>
                                }
                                <table class="table table-sm align-middle">
                                    <thead>
                                        <tr>
                                            <th style="width: 6rem;">Order</th>
                                            <th>Question</th>
                                            <th style="width: 6rem;"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in sectionGroup)
                                        {
                                            <tr>
                                                <td>
                                                    <input type="number" name="order[@item.QuestionId]" value="@item.Order" class="form-control form-control-sm" />
                                                </td>
                                                <td>@(item.QuestionTitle.Length > 80 ? item.QuestionTitle.Substring(0, 80) + "…" : item.QuestionTitle)</td>
                                                <td>
                                                    <button type="submit" form="remove-form-@item.QuestionId" class="btn btn-sm btn-outline-danger">Remove</button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            <button type="submit" class="btn btn-sm btn-secondary">Save Order</button>
                        </form>

                        @foreach (var item in items)
                        {
                            <form method="post" asp-page-handler="Remove" id="remove-form-@item.QuestionId" class="d-none">
                                <input type="hidden" asp-for="SectionId" />
                                <input type="hidden" name="questionId" value="@item.QuestionId" />
                            </form>
                        }
                    </div>
                </div>

                <div class="modal fade" id="editInstructionModal-@pageGroup.Key" tabindex="-1" aria-labelledby="editInstructionModalLabel-@pageGroup.Key" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <form method="post" asp-page-handler="SetInstruction">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="editInstructionModalLabel-@pageGroup.Key">Page @pageGroup.Key Instruction</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <input type="hidden" asp-for="SectionId" />
                                    <input type="hidden" name="pageNumber" value="@pageGroup.Key" />
                                    <div class="mb-3">
                                        <label class="form-label">Instruction</label>
                                        <input type="text" name="instruction" class="form-control" value="@pageInstruction" placeholder="e.g. Multiple Choice Questions" />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Sub-instruction</label>
                                        <textarea name="subInstruction" class="form-control" rows="2" placeholder="e.g. Answer every question below, then submit to see your score.">@pageSubInstruction</textarea>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-primary">Save</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="modal fade" id="addSectionModal-@pageGroup.Key" tabindex="-1" aria-labelledby="addSectionModalLabel-@pageGroup.Key" aria-hidden="true">
                    <div class="modal-dialog modal-lg modal-dialog-scrollable">
                        <div class="modal-content">
                            <form method="post" asp-page-handler="AddSection">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="addSectionModalLabel-@pageGroup.Key">Add a section to page @pageGroup.Key</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <input type="hidden" asp-for="SectionId" />
                                    <input type="hidden" name="pageNumber" value="@pageGroup.Key" />
                                    <div class="mb-3">
                                        <label class="form-label">Question Type</label>
                                        <select name="questionTypeId" class="form-select js-section-type" asp-items="Model.QuestionTypeOptions" required>
                                            <option value="">-- Select Question Type --</option>
                                        </select>
                                        <div class="form-text">The new section is added after the existing sections on this page.</div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Instruction <span class="text-muted small">(optional)</span></label>
                                        <input type="text" name="instruction" class="form-control" placeholder="e.g. Identification" />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Sub-instruction <span class="text-muted small">(optional)</span></label>
                                        <textarea name="subInstruction" class="form-control" rows="2" placeholder="e.g. Type your answer in the box provided."></textarea>
                                    </div>
                                    <label class="form-label">Questions to assign</label>
                                    <p class="text-muted small js-question-hint mb-2">Pick a question type to see its questions.</p>
                                    <div class="border rounded p-2">
                                        @foreach (var question in Model.AssignableQuestions)
                                        {
                                            <div class="form-check js-question-item d-none" data-type-id="@question.QuestionTypeId">
                                                <input class="form-check-input" type="checkbox" name="questionIds" value="@question.QuestionId" id="add-@pageGroup.Key-@question.QuestionId" />
                                                <label class="form-check-label" for="add-@pageGroup.Key-@question.QuestionId">
                                                    @(question.QuestionTitle.Length > 90 ? question.QuestionTitle.Substring(0, 90) + "…" : question.QuestionTitle)
                                                    <span class="badge @(question.PageSectionId == 0 ? "bg-warning text-dark" : "bg-light text-dark border") ms-1">@PlacementLabel(question)</span>
                                                </label>
                                            </div>
                                        }
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-primary">Add Section</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                @foreach (var sectionGroup in items.GroupBy(i => i.PageSectionId))
                {
                    var sectionTypeId = sectionGroup.First().QuestionTypeId;
                    var candidates = Model.AssignableQuestions
                        .Where(q => q.QuestionTypeId == sectionTypeId && q.PageSectionId != sectionGroup.Key)
                        .ToList();
                    <div class="modal fade" id="sectionInstructionModal-@sectionGroup.Key" tabindex="-1" aria-labelledby="sectionInstructionModalLabel-@sectionGroup.Key" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <form method="post" asp-page-handler="SetSectionInstruction">
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="sectionInstructionModalLabel-@sectionGroup.Key">Page @pageGroup.Key, section @sectionGroup.First().SectionNumber instruction</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        <input type="hidden" asp-for="SectionId" />
                                        <input type="hidden" name="pageSectionId" value="@sectionGroup.Key" />
                                        <p class="text-muted small">Shown above this section's first question on the exam and simulation pages.</p>
                                        <div class="mb-3">
                                            <label class="form-label">Instruction</label>
                                            <input type="text" name="instruction" class="form-control" value="@sectionGroup.First().SectionInstruction" placeholder="e.g. Identification" />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Sub-instruction</label>
                                            <textarea name="subInstruction" class="form-control" rows="2" placeholder="e.g. Type your answer in the box provided.">@sectionGroup.First().SectionSubInstruction</textarea>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-primary">Save</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                    <div class="modal fade" id="assignQuestionsModal-@sectionGroup.Key" tabindex="-1" aria-labelledby="assignQuestionsModalLabel-@sectionGroup.Key" aria-hidden="true">
                        <div class="modal-dialog modal-lg modal-dialog-scrollable">
                            <div class="modal-content">
                                <form method="post" asp-page-handler="AssignQuestions">
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="assignQuestionsModalLabel-@sectionGroup.Key">
                                            Assign questions to page @pageGroup.Key, section @sectionGroup.First().SectionNumber
                                            <span class="badge bg-secondary ms-1">@sectionGroup.First().QuestionTypeName</span>
                                        </h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        <input type="hidden" asp-for="SectionId" />
                                        <input type="hidden" name="pageSectionId" value="@sectionGroup.Key" />
                                        @if (candidates.Count == 0)
                                        {
                                            <p class="text-muted mb-0">There are no other active @sectionGroup.First().QuestionTypeName questions to assign.</p>
                                        }
                                        else
                                        {
                                            <p class="text-muted small">Questions already on another page or section are moved here.</p>
                                            <div class="border rounded p-2">
                                                @foreach (var question in candidates)
                                                {
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="checkbox" name="questionIds" value="@question.QuestionId" id="assign-@sectionGroup.Key-@question.QuestionId" />
                                                        <label class="form-check-label" for="assign-@sectionGroup.Key-@question.QuestionId">
                                                            @(question.QuestionTitle.Length > 90 ? question.QuestionTitle.Substring(0, 90) + "…" : question.QuestionTitle)
                                                            <span class="badge @(question.PageSectionId == 0 ? "bg-warning text-dark" : "bg-light text-dark border") ms-1">@PlacementLabel(question)</span>
                                                        </label>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                        @if (candidates.Count > 0)
                                        {
                                            <button type="submit" class="btn btn-primary">Assign</button>
                                        }
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            }

            <div class="card mb-0">
                <div class="card-header fw-semibold">Unassigned Questions</div>
                <div class="card-body">
                    @if (Model.UnassignedQuestions.Count == 0)
                    {
                        <p class="text-muted mb-0">Every active question in this section has been bundled onto a page.</p>
                    }
                    else
                    {
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Question</th>
                                    <th style="width: 10rem;">Type</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.UnassignedQuestions)
                                {
                                    <tr>
                                        <td>@(item.QuestionTitle.Length > 80 ? item.QuestionTitle.Substring(0, 80) + "…" : item.QuestionTitle)</td>
                                        <td><span class="badge bg-secondary">@item.QuestionTypeName</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        }
    </div>
</div>

@functions {
    private static string PlacementLabel(AAExamManagementSystem.Models.Dtos.PageSectionDto question) =>
        question.PageSectionId == 0 ? "Unassigned" : $"Page {question.PageNumber} · Section {question.SectionNumber}";
}

@section Scripts {
    <script>
        document.querySelectorAll('.js-section-type').forEach(function (select) {
            var modal = select.closest('.modal');
            var hint = modal.querySelector('.js-question-hint');

            function applyTypeFilter() {
                var visible = 0;
                modal.querySelectorAll('.js-question-item').forEach(function (item) {
                    var show = select.value !== '' && item.dataset.typeId === select.value;
                    item.classList.toggle('d-none', !show);
                    if (!show) {
                        item.querySelector('input').checked = false;
                    } else {
                        visible++;
                    }
                });

                hint.classList.toggle('d-none', select.value !== '' && visible > 0);
                hint.textContent = select.value === ''
                    ? 'Pick a question type to see its questions.'
                    : 'There are no active questions of that type in this department.';
            }

            select.addEventListener('change', applyTypeFilter);
            applyTypeFilter();
        });
    </script>
}
