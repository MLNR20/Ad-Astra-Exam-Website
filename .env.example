ad-astra-exam-password=""
ConnectionStrings:DefaultConnection="Host=db.<project-ref>.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=<password>;SSL Mode=Require;Trust Server Certificate=true"
# Email on Render (its free plan blocks SMTP ports 25/465/587): use a relay on port 2525, for example Brevo.
# Set these as Render environment variables (Email__Host, Email__Port, Email__Username, Email__From):
#   Email__Host=smtp-relay.brevo.com  Email__Port=2525  Email__Username=<your relay SMTP login>  Email__From=<a sender verified at the relay>
# ad-astra-exam-password above is then the relay's SMTP key.
# Keep-alive: the app pings its own /healthz every 10 minutes so a free Render service does not sleep.
# On Render it needs no setting (the platform provides RENDER_EXTERNAL_URL). Elsewhere set
# KeepAlive__Url=https://<your-site> (and optionally KeepAlive__IntervalMinutes=10). Leave unset locally.
